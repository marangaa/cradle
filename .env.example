# ==========================================
# Cradle Monorepo Environment Variables
# ==========================================

# Database: PostgreSQL with pgvector extension enabled (Neon, Supabase, or Docker)
DATABASE_URL=postgresql://user:password@localhost:5432/cradle

# Better Auth Configuration (Studio at :3004, Runtime at :3002)
BETTER_AUTH_SECRET=replace_with_a_random_32_byte_secret
BETTER_AUTH_URL=http://localhost:3004

# Service URLs
NEXT_PUBLIC_RUNTIME_URL=http://localhost:3002

# AI / LLM Provider (Google Gemini API Key — BYOK)
GOOGLE_GENERATIVE_AI_API_KEY=your-google-ai-studio-key
CRADLE_MODEL_ID=gemini-flash-lite-latest

# Crawler Provider (Firecrawl API Key — BYOK)
FIRECRAWL_API_KEY=fc-your-firecrawl-key
