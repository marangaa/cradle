FIRECRAWL_API_KEY=fc-your-firecrawl-key
DATABASE_URL=postgres://cradle:cradle@localhost:5432/cradle
BETTER_AUTH_SECRET=replace_with_the_same_random_32_byte_secret_as_studio
# Runtime validates the cookie issued by Studio, so this must be Studio's public URL.
BETTER_AUTH_URL=http://localhost:3004

NEXT_PUBLIC_RUNTIME_URL=http://localhost:3002

# Required for the built-in chatbot (site-knowledge search + the chat agent itself). Needs a
# database with the pgvector extension enabled (CREATE EXTENSION IF NOT EXISTS vector;) for
# knowledge_chunks — drizzle-kit does not enable extensions on its own.
GOOGLE_GENERATIVE_AI_API_KEY=your-google-ai-studio-key
# Optional — defaults to gemini-flash-lite-latest (an alias Google keeps pointed at their current
# cheapest Flash-Lite model, so this doesn't need manual bumping when a given dated model is
# deprecated).
CRADLE_MODEL_ID=gemini-flash-lite-latest
